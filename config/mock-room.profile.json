{
  "name": "mock-room",
  "baseUrl": "http://localhost:8787",
  "login": {
    "url": "http://localhost:8787/login",
    "checkUrl": "http://localhost:8787/my",
    "successSelector": "#account",
    "usernameSelector": "#userid",
    "passwordSelector": "#userpw",
    "submitSelector": "#login-btn"
  },
  "search": {
    "urlTemplate": "http://localhost:8787/booking?date={date}&room={room}",
    "waitFor": "#slot-list",
    "slotSelector": ".slot",
    "unavailableSelector": ".sold-out",
    "fields": { "time": ".slot-time", "url": "self" }
  },
  "book": {
    "clickSlot": true,
    "steps": [
      { "action": "waitFor", "selector": "#name" },
      { "action": "fill", "selector": "#name", "valueFrom": "env:BOOKING_NAME" },
      { "action": "fill", "selector": "#phone", "valueFrom": "env:BOOKING_PHONE" },
      { "action": "check", "selector": "#agree" },
      { "action": "click", "selector": "#confirm-btn", "final": true }
    ],
    "successSelector": ".done",
    "confirmationSelector": ".code"
  }
}
