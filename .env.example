# ── 로그인 정보 (이 파일을 .env 로 복사해서 채우세요. .env 는 커밋되지 않습니다) ──
SITE_USERNAME=
SITE_PASSWORD=

# 예약 폼에 들어갈 개인정보 (프로필의 valueFrom: "env:..." 로 참조)
BOOKING_NAME=
BOOKING_PHONE=
BOOKING_EMAIL=

# ── 알림 (선택) ──
# Slack / Discord / 임의의 JSON 웹훅 URL
WEBHOOK_URL=
# 텔레그램 봇 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 동작 옵션 ──
# true 면 최종 결제/확정 버튼을 누르기 직전에 멈춥니다 (기본값: true)
DRY_RUN=true
# 브라우저 창을 띄울지 여부
HEADLESS=true

# 크로미움 바이너리를 직접 지정해야 할 때만 사용 (보통은 비워둡니다)
CHROMIUM_PATH=
