{
  "name": "reserve",
  "version": "0.1.0",
  "description": "실시간 예약 감시 및 자동 예약 CLI",
  "type": "module",
  "private": true,
  "bin": {
    "reserve": "./src/cli.ts"
  },
  "scripts": {
    "reserve": "tsx src/cli.ts",
    "login": "tsx src/cli.ts login",
    "check": "tsx src/cli.ts check",
    "watch": "tsx src/cli.ts watch",
    "mock": "tsx src/mock/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "serve": "tsx src/cli.ts serve",
    "app": "tsx src/cli.ts serve"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
